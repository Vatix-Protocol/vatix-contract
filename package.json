{
  "name": "vatix-contract",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "build:bindings": "tsx scripts/generate-bindings.ts",
    "env:sync": "tsx scripts/sync-frontend-env.ts",
    "lint:web": "pnpm --filter web lint",
    "issues:generate": "tsx scripts/generate-issues.ts",
    "issues:publish": "tsx scripts/generate-issues.ts --publish",
    "testnet:smoke": "bash scripts/testnet-smoke.sh",
    "install:all": "pnpm install --frozen-lockfile",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r exec rm -rf node_modules dist"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.15.0"
}
