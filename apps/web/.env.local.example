# Soroban contract configuration
# Copy this file to .env.local and fill in your values.
#
# Canonical registry: see /deployments/testnet.json (and deployments/README.md)
# at the repo root for the source-of-truth testnet contract IDs, network
# passphrase, and RPC URL. Copy the relevant `contractId` values from there
# into the NEXT_PUBLIC_*_CONTRACT_ID vars below.
#
# SECRET-FREE: every value in this file is a PUBLIC placeholder. All keys are
# NEXT_PUBLIC_* and are inlined into the browser bundle, so they MUST NOT hold
# secrets, tokens, or credentials. Never commit real secret keys here; keep
# signing keys in a wallet (e.g. Freighter) or a server-side secret store.
#
# FAIL-CLOSED: leave the *_CONTRACT_ID vars empty until you have copied the
# correct IDs for your target network. Empty IDs make the app refuse to talk to
# a contract rather than silently defaulting to mainnet. The defaults below
# point at TESTNET only; to target mainnet you must set every value explicitly
# (mainnet RPC, passphrase, Horizon, and explorer URLs) and confirm the IDs
# come from the mainnet registry, not testnet.json.

# --- Contract IDs (PUBLIC; copy from deployments/<network>.json) ---
# Leave blank to fail closed; do not paste mainnet IDs while using testnet URLs.

# Market Contract ID deployed on the target network
NEXT_PUBLIC_MARKET_CONTRACT_ID=

# Treasury Contract ID
NEXT_PUBLIC_TREASURY_CONTRACT_ID=

# Outcome Token Contract ID
NEXT_PUBLIC_OUTCOME_TOKEN_CONTRACT_ID=

# Resolution Contract ID
NEXT_PUBLIC_RESOLUTION_CONTRACT_ID=

# --- Network endpoints (PUBLIC; testnet defaults) ---

# Soroban RPC endpoint (default: Stellar testnet)
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (testnet default; set the mainnet passphrase explicitly for mainnet)
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Horizon endpoint (for submitting signed transactions)
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar Explorer base URL for transaction links (default: Stellar Expert testnet)
NEXT_PUBLIC_EXPLORER_URL=https://stellar.expert/explorer/testnet/tx
