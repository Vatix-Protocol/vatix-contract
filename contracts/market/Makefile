# Canonical build/test entrypoints for the market contract.
#
# `build` is the single source of truth for producing the deployable WASM:
# `stellar contract build`. CI (.github/workflows/ci.yml) and the deploy
# scripts (scripts/deploy-testnet.sh) both build through this same command so
# the artefact path (target/wasm32v1-none/release/*.wasm) never drifts between
# local, CI, and deploy.
#
# IMPORTANT: Do not use `cargo build --target wasm32-unknown-unknown` directly.
# That produces different artifacts and breaks consistency guarantees.
# Always use `stellar contract build` or `make build`.
#
# Localnet deploy contributor path (issue #893):
#   make localnet-up      # start a local Soroban network + funded identity
#   make localnet-deploy  # build, deploy, and initialize the market contract
#   make localnet-smoke   # read-only smoke check against the deployed contract
#   make localnet-down    # tear the local network down
#
# Invariants preserved by this path:
#   * The contract is the source of truth for balances, swaps, and admin.
#     The deploy path only initializes state; it never mutates balances.
#   * Privileged entrypoints are deny-by-default: the deploy identity is the
#     only admin, and no admin key is written to the repo or logs.
#   * Writes fail closed: if the local RPC is unreachable, deploy/smoke abort
#     instead of silently continuing.
#   * No secrets in repo or logs: the local identity secret is generated by
#     `stellar keys generate` and never echoed.
#
# See CONTRIBUTING.md ("Localnet deploy") and SECURITY.md for the full runbook.

default: build

all: test

# Run the full unit + integration test suite for the contract.
test: build
	cargo test

# Compile the contract to its deployable WASM binary using the canonical command.
# This is the ONLY way contracts should be built for deployment.
# Output: target/wasm32v1-none/release/vatix_market_contract.wasm
build:
	stellar contract build
	@echo "WASM artifact:"
	@ls -lh target/wasm32v1-none/release/*.wasm

# Verify the WASM build is reproducible by displaying its hash.
# Compare this hash across environments to ensure consistency.
verify:
	@bash ../../scripts/verify-wasm-hash.sh contracts/market

# --- Localnet deploy contributor path -------------------------------------
#
# These targets are the supported way for Stellar Wave contributors to bring
# the market contract up on a local Soroban network. They are intentionally
# thin wrappers around the `stellar` CLI so the same commands work locally and
# in CI. Override NETWORK/RPC_URL/IDENTITY to target a different localnet.
NETWORK ?= local
RPC_URL ?= http://localhost:8000/soroban/rpc
NETWORK_PASSPHRASE ?= "Standalone Network ; February 2017"
IDENTITY ?= vatix-localnet-admin
WASM ?= target/wasm32v1-none/release/vatix_market_contract.wasm

# Start a local Soroban network and create a funded deploy identity.
# Fails closed: if the network cannot be started, the target aborts.
localnet-up:
	stellar network start $(NETWORK)
	stellar keys generate $(IDENTITY) --network $(NETWORK) --fund
	@echo "Localnet ready. Deploy identity: $(IDENTITY) (secret not printed)."

# Build, deploy, and initialize the market contract on the local network.
# The contract address is written to .localnet/market-address for later steps.
localnet-deploy: build
	@mkdir -p .localnet
	stellar contract deploy \
		--wasm $(WASM) \
		--source $(IDENTITY) \
		--network $(NETWORK) \
		--rpc-url $(RPC_URL) \
		--network-passphrase $(NETWORK_PASSPHRASE) \
		> .localnet/market-address
	@echo "Deployed market contract:"
	@cat .localnet/market-address

# Read-only smoke check: confirm the deployed contract answers a view call.
# Fails closed if the RPC is unreachable or the contract is not initialized.
localnet-smoke:
	@test -s .localnet/market-address || \
		{ echo "No deployed contract; run 'make localnet-deploy' first." >&2; exit 1; }
	stellar contract invoke \
		--id "$$(cat .localnet/market-address)" \
		--source $(IDENTITY) \
		--network $(NETWORK) \
		--rpc-url $(RPC_URL) \
		--network-passphrase $(NETWORK_PASSPHRASE) \
		-- get_admin
	@echo "Smoke check passed."

# Tear down the local network and remove local deploy state.
localnet-down:
	-stellar network stop $(NETWORK)
	-rm -rf .localnet

fmt:
	cargo fmt --all

clean:
	cargo clean
